# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Canonical site address (used for canonical URLs, sitemap, sharing image, QR code)
SITE_URL=https://seaairclub.co.uk

# Sign-up storage: 'blob' in production (needs BLOB_READ_WRITE_TOKEN), 'memory' locally
SIGNUP_STORE=memory

# Added automatically when the Vercel Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# Optional: also POST each new sign-up to this URL (Zapier, Make, Google Sheet script, ResNexus connector)
SIGNUP_WEBHOOK_URL=
SIGNUP_WEBHOOK_SECRET=

# Password for /api/admin/signups.csv (username: admin). Leave empty to disable the export.
ADMIN_EXPORT_PASSWORD=

# Email through Resend. Only the production deployment ever sends (VERCEL_ENV=production),
# so a key here does nothing locally or on previews.
RESEND_API_KEY=
# "You're on the list" email to each new sign-up. Needs the from domain verified in Resend.
WELCOME_EMAIL_FROM=
WELCOME_EMAIL_REPLY_TO=
# Mon/Wed/Fri digest of new sign-ups, with a CSV for the ResNexus import (comma-separate several To addresses)
SIGNUP_DIGEST_FROM=
SIGNUP_DIGEST_TO=
# Vercel Cron sends this as a bearer token to /api/cron/signup-digest. Unset switches the route off (404).
CRON_SECRET=

# Set to true while the site runs on its vercel.app address, before seaairclub.co.uk is connected.
# Adds noindex to every page and blocks crawling in robots.txt. Remove at go-live.
SITE_NOINDEX=
