---
/**
 * Full-screen shell for the standalone sign-up pages (/join and /join/thanks):
 * the hero photo behind, with the same panel as the pop-up on top.
 */
import { Picture } from 'astro:assets';
import { home, images } from '@/content/home';

const image = images[home.hero.image];
---

<main id="main" class="on-dark relative isolate flex min-h-dvh flex-col bg-driftwood">
  <Picture
    src={image.src}
    alt=""
    formats={['avif', 'webp']}
    widths={[480, 768, 1024, 1280, image.src.width]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-[85%_50%] lg:object-[50%_100%]"
  />
  <div class="absolute inset-0 -z-10 bg-driftwood/60" aria-hidden="true"></div>

  <header class="px-(--gutter) pt-5 text-center text-off-white lg:pt-[30px]">
    <a href="/" class="wordmark inline-block py-2" aria-label="Sea Air Club, home">Sea Air Club</a>
  </header>

  <div class="flex flex-1 items-end justify-center pt-16 sm:items-center sm:px-6 sm:py-16">
    <div
      class="w-full rounded-t-(--radius-sheet) bg-off-white px-6 pt-8 pb-[calc(2.25rem+env(safe-area-inset-bottom))] text-driftwood sm:max-w-[35rem] sm:rounded-(--radius-button) sm:p-12"
    >
      <slot />
    </div>
  </div>
</main>
