---
/**
 * Top bar over the hero: the wordmark, centred, with Instagram on the left on desktop
 * (once the handle is set). Sits absolutely over the hero so the photo runs to the top.
 */
import { site } from '@/config/site';
---

<header class="on-dark absolute inset-x-0 top-0 z-20 px-(--gutter) pt-5 text-off-white lg:pt-[30px]">
  <div class="grid min-h-[39px] grid-cols-[1fr_auto_1fr] items-center gap-4">
    <div>
      {
        site.instagramUrl && (
          <a
            href={site.instagramUrl}
            class="hidden text-button-s font-medium underline-offset-4 hover:underline lg:inline"
            rel="noopener"
            target="_blank"
          >
            Instagram
          </a>
        )
      }
    </div>
    <a href="/" class="wordmark justify-self-center" aria-label="Sea Air Club, home">Sea Air Club</a>
    <div aria-hidden="true"></div>
  </div>
</header>
